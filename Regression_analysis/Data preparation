# neighborhood data preprocessing and join with the rq2 predictors

## note: these data have the number of inwoners per neighborhood. we do an intersection of each campus with the neighborhoods the numbers we get represent the surrounding neighborhood NOT the total number of inhabitants per campus. So if campuses overlap multiple neighborhoods they may have more inhabitants (and thus more potential participants in the citizen science)

## Read neighborhood data WITH inhabitant numbers! (without spatial info)

kwb <- read.csv("C:/Users/Const007/OneDrive - Universiteit Utrecht/Desktop/PhD_planning/1.Weekly_meetings/2026/01/Analysis/RQ2/CBS_data/kwb_2025.csv", sep = ";")

## Read neighborhood data with spatial info -- R selects automatically the first layer. Since the first is the neighborhoods (buurt) i am happy to keep it as it as and not define which layer to use

wijkenbuurten<-st_read("C:/Users/Const007/OneDrive - Universiteit Utrecht/Desktop/PhD_planning/1.Weekly_meetings/2026/01/Analysis/RQ2/CBS_data/wijkenbuurten_2025_v1.gpkg")  

# rename the 10 digit neighborhood column in wijkenbuurten to match the colmn in kwb dataset
names(wijkenbuurten)[names(wijkenbuurten) == "buurtcode"] <- "gwb_code_10"
  
# join the two datasets
wijkenbuurten_kwb <- left_join(wijkenbuurten, kwb, by = "gwb_code_10")

## spatially join the joined dataset with the campus boundaries through an intersection. this gives all the neighborhoods and their corresponding numbers we need for each campus
wijkenbuurten_kwb_campus <- st_join(campus_boundaries_merged_filtered,wijkenbuurten_kwb,join = st_intersects)

# filter the most interesting columns for our analysis
wijkenbuurten_kwb_campus_filter <- wijkenbuurten_kwb_campus[,c("campus","gwb_code_10","buurtnaam","gemeentenaam","aantal_inwoners","bev_dich" )]

wijkenbuurten_kwb_campus_filter <- st_drop_geometry(wijkenbuurten_kwb_campus_filter)

write.csv(wijkenbuurten_kwb_campus_filter,"C:/Users/Const007/OneDrive - Universiteit Utrecht/Desktop/PhD_planning/1.Weekly_meetings/2026/01/Analysis/RQ2/CBS_data/kwb_wijkenbuurten_campus1.csv")

## estimate the total inhabitants for the neighborhoods for which each campus belongs to 
wijkenbuurten_kwb_campus_filter_group <- wijkenbuurten_kwb_campus_filter %>%
  group_by(campus) %>%
  summarize(inhabitants = sum(aantal_inwoners))

### join
rq2_predictors <- rq2_predictors %>%
  left_join(wijkenbuurten_kwb_campus_filter_group, by = "campus")

### join with the responses
rq2_predictors_response <- rq2_predictors %>%
  left_join(rq2_responses, by = "campus")


