#Scope
## all data


### remove and spaces or _ that may have remained
coef_table_scope_copy <- coef_table_scope_copy %>%
  mutate(
    dataset_clean = dataset %>%
      stringr::str_replace_all("_", " ") %>%
      stringr::str_to_sentence()
  )

## reorder alphabeticaly 
coef_table_scope_copy <- coef_table_scope_copy %>%
  mutate(
    dataset_clean = factor(
      dataset_clean,
      levels = sort(unique(dataset_clean))
    )
  )

#plot
coef_table_scope_copy_plot <- ggplot(
  coef_table_scope_copy,
  aes(
    x = estimate,
    y = dataset_clean,
    colour = predictor, shape = Significance
  )
) +
geom_vline(
  xintercept = 0,
  linetype = "dashed",
  colour = "grey60"
) +

geom_errorbarh(
  aes(
    xmin = conf.low,
    xmax = conf.high
  ),
  height = 0.2,
  linewidth = 0.4
) +

geom_point(
    size = 2.5
) +

scale_alpha_manual(
  values = c(
    "TRUE" = 1,
    "FALSE" = 0.25
  ),
  guide = "none"
) +

theme_classic(base_size = 12)+
labs(
  x = "Estimated regression coefficient",
  y = "Response variables for scope",
  colour = "Predictor"
) + scale_colour_viridis_d(option = "D")



