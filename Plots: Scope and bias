### style function
visuals_function <- function() {

  theme_classic(base_size = 11) + 
    theme(
      text = element_text(family = "sans"),
      axis.text.x = element_text(angle = 45, hjust = 1),
      plot.title = element_text(face = "italic", size = 12),
      axis.title = element_text(face = "bold"),
      strip.background = element_blank(),
      panel.grid.minor = element_blank(),
      legend.position = "top",
      legend.title = element_blank(),
      plot.tag = element_text(face = "bold", size = 12),
      plot.tag.position = c(0, 1),
      plot.margin = margin(5, 5, 5, 5)
    )
}

### boxplot function
boxplot_function <- function(data, x, y, fill = NULL) {

  if (is.null(substitute(fill))) {

    # CASE 1: no fill
    ggplot(data, aes(x = {{ x }}, y = {{ y }})) +
      geom_boxplot( fill = "steelblue") +
      theme_classic()

  } else {

    # CASE 2: with fill
    ggplot(
      data,
      aes(
        x = {{ x }},
        y = {{ y }},
        fill = {{ fill }},
        group = interaction({{ x }}, {{ fill }})
      )
    ) +
      geom_boxplot(position = position_dodge(0.8)) +
      theme_classic()
  }
}


boxplot_function_tax <- function(data, x, y, fill = NULL) {

       ggplot(
      data,
      aes(
        x = {{ x }},
        y = {{ y }},
        fill = {{ fill }},
        group = interaction({{ x }}, {{ fill }})
      )
    ) +
      geom_boxplot(position = position_dodge(0.8)) +
      theme_classic()
  }


