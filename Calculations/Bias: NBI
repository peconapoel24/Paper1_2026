  res <- sapply(sublist, function(points_sf){
    d <- st_distance(points_sf, velp_build24)
    min_dists <- apply(d, 1, min)  
    mean(as.numeric(min_dists))
  })
  message("Finished sublist ", i, " / ", length(random_replicates_velp_24))
  res
})

